{
  "name": "notepalette",
  "version": "0.1.0",
  "description": "ノートの俯瞰性とNotepad++の不揮発性を兼ね備えたメモアプリ",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "test": "npm run build && node --test tests/*.test.js",
    "test:ui": "npm run build && node --test tests/ui.test.js",
    "start": "npm run build && electron .",
    "pack": "node scripts/pack.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
